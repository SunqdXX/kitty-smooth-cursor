diff --git a/kitty/shaders/smooth_cursor.slang b/kitty/shaders/smooth_cursor.slang
new file mode 100644
index 000000000..25a8aa4ac
--- /dev/null
+++ b/kitty/shaders/smooth_cursor.slang
@@ -0,0 +1,57 @@
+#language slang 2026
+// Distributed under terms of the GPLv3 license.
+
+// The animated cursor of cursor_smooth_motion, a port of the DRAW_INVERTING
+// rect shader of alacritty-smooth-cursor. It is drawn after the frame has
+// been rendered and samples the frame below itself, so that text stays
+// readable while the cursor travels over it.
+
+import blit_common;
+import linear2srgb;
+
+struct VSOutput {
+    float2 texcoord : TEXCOORD0;
+    float2 pixel : TEXCOORD1; // position relative to the top left corner of the cursor, in pixels
+    float2 size : TEXCOORD2;  // size of the cursor, in pixels
+    float4 position : SV_Position;
+};
+
+[shader("vertex")]
+VSOutput
+vertex_main(uint vertex_id: SV_VertexID, uniform float4 src_rect, uniform float4 dest_rect, uniform float2 size_px) {
+    BlitOutput ans = get_coords_for_blit(vertex_id, src_rect, dest_rect);
+    VSOutput output;
+    output.texcoord = ans.texcoord;
+    output.pixel = get_coords_for_blit(vertex_id, float4(0.0, 0.0, size_px.x, size_px.y), dest_rect).texcoord;
+    output.size = size_px;
+    output.position = float4(ans.position[0], ans.position[1], 0.0, 1.0);
+    return output;
+}
+
+uniform Sampler2D image;
+
+[shader("fragment")]
+float4
+fragment_main(
+    float2 texcoord: TEXCOORD0, float2 pixel: TEXCOORD1, float2 size: TEXCOORD2,
+    uniform float3 cursor_color, uniform float3 bg_color, uniform float2 hollow_thickness, uniform float alpha)
+    : SV_Target {
+    // The frame is premultiplied linear color, the original works in sRGB
+    float4 below_premul = image.Sample(texcoord);
+    float3 below = below_premul.a > 0.0 ? linear2srgb(below_premul.rgb / below_premul.a) : float3(0.0);
+    // How far the pixel is from the background, i.e. how much of it is text
+    float factor = length(bg_color - below);
+    // If the text is too close to the cursor color, either dim or brighten it
+    // so that their values are at least 0.5 apart
+    float3 text = below;
+    float v_cursor = max(cursor_color.r, max(cursor_color.g, cursor_color.b));
+    float v_text = max(text.r, max(text.g, text.b));
+    if (v_text != 0.0 && abs(v_cursor - v_text) < 0.5) {
+        text *= (v_cursor > 0.5 ? v_cursor - 0.5 : v_cursor + 0.5) / v_text;
+    }
+    float3 color = saturate(lerp(cursor_color, text, factor));
+    // Hollow cursors draw only their outline
+    float2 inside = step(hollow_thickness, pixel) * step(pixel, size - hollow_thickness);
+    float a = alpha * (1.0 - inside.x * inside.y * step(0.5, hollow_thickness.x));
+    return float4(color * a, a);
+}
diff --git a/kitty/smooth_cursor.c b/kitty/smooth_cursor.c
new file mode 100644
index 000000000..4d50bf2b7
--- /dev/null
+++ b/kitty/smooth_cursor.c
@@ -0,0 +1,183 @@
+/*
+ * smooth_cursor.c
+ * Distributed under terms of the GPLv3 license.
+ *
+ * Smooth cursor motion, ported from alacritty-smooth-cursor
+ * (https://github.com/GregTheMadMonk/alacritty-smooth-cursor).
+ *
+ * The cursor is drawn as a rectangle whose four edges independently ease
+ * towards the edges of the real cursor. The edges on the side the cursor is
+ * moving towards use cursor_smooth_motion_factor, the trailing edges use
+ * cursor_smooth_motion_factor * cursor_smooth_motion_spring, so the cursor
+ * stretches while it travels. The stretch is capped by
+ * cursor_smooth_motion_max_stretch. While the animation runs the real cursor
+ * is hidden and the rectangle is drawn by draw_smooth_cursor() instead.
+ */
+
+#include "state.h"
+#include "lineops.h"
+
+#define WD w->render_data
+enum { LEFT, TOP, RIGHT, BOTTOM };
+
+// Below this the rect is considered to have reached its target, the same
+// tolerance alacritty-smooth-cursor uses (it compares rounded pixels)
+#define POSITION_TOLERANCE 0.5f
+#define ALPHA_TOLERANCE (1.f / 255.f)
+
+static float
+lerp(float a, float b, float f) {
+    return a * (1.f - f) + b * f;
+}
+
+// The factors are specified as the fraction of the remaining distance covered
+// per 1/60th of a second. Convert to the fraction for a step of dt seconds so
+// that the animation speed does not depend on the frame rate.
+static float
+step_fraction(float factor, float dt) {
+    if (factor >= 1.f) return 1.f;
+    if (factor <= 0.f) return 0.f;
+    return 1.f - powf(1.f - factor, dt * 60.f);
+}
+
+static unsigned
+thickness_in_px(float pts, double dpi, unsigned cell_dimension) {
+    // Same as vert()/horz() in decorations.c so the animated cursor ends up
+    // exactly the size of the real one
+    unsigned ans = (unsigned)round(pts * dpi / 72.0);
+    return MAX(1u, MIN(ans, cell_dimension));
+}
+
+static void
+compute_target(Window *w, OSWindow *os_window, float target[4], float *alpha, bool *hollow) {
+    Screen *screen = WD.screen;
+    const CursorRenderInfo *cri = &screen->cursor_render_info;
+    const float cw = screen->cell_size.width, ch = screen->cell_size.height;
+    const float left = WD.geometry.left + cri->x * cw, top = WD.geometry.top + cri->y * ch;
+    CursorShape shape = (cri->is_focused || OPT(cursor_shape_unfocused) == NO_CURSOR_SHAPE) ? cri->shape : OPT(cursor_shape_unfocused);
+    // A hidden cursor animates as an invisible block, like in the original
+    *alpha = cri->is_visible ? 1.f : 0.f;
+    if (!cri->is_visible) shape = CURSOR_BLOCK;
+    // Cursors on multicell characters are enlarged, see cell_update_uniform_block() in shaders.c
+    unsigned cols = 1, rows = 1;
+    if (cri->x < screen->columns && cri->y < screen->lines) {
+        LineBuf *lb = screen->paused_rendering.expires_at ? screen->paused_rendering.linebuf : screen->linebuf;
+        linebuf_init_line(lb, cri->y);
+        const CPUCell *c = &lb->line->cpu_cells[cri->x];
+        if (c->is_multicell && c->x == 0 && c->y == 0) {
+            cols = mcd_x_limit(c);
+            rows = c->scale;
+        }
+    }
+    target[LEFT] = left;
+    target[TOP] = top;
+    target[RIGHT] = left + cols * cw;
+    target[BOTTOM] = top + rows * ch;
+    *hollow = false;
+    switch (shape) {
+        case CURSOR_BEAM:
+            target[RIGHT] = left + thickness_in_px(OPT(cursor_beam_thickness), os_window->fonts_data->logical_dpi_x, screen->cell_size.width);
+            break;
+        case CURSOR_UNDERLINE:
+            target[TOP] = target[BOTTOM] - thickness_in_px(OPT(cursor_underline_thickness), os_window->fonts_data->logical_dpi_y, screen->cell_size.height);
+            break;
+        case CURSOR_HOLLOW:
+            target[RIGHT] = left + cw;
+            target[BOTTOM] = top + ch;
+            *hollow = true;
+            break;
+        default: break;
+    }
+}
+
+static bool
+rects_equal(const float a[4], const float b[4]) {
+    return a[LEFT] == b[LEFT] && a[TOP] == b[TOP] && a[RIGHT] == b[RIGHT] && a[BOTTOM] == b[BOTTOM];
+}
+
+static bool
+rects_close(const float a[4], const float b[4]) {
+    for (int i = 0; i < 4; i++) {
+        if (fabsf(a[i] - b[i]) >= POSITION_TOLERANCE) return false;
+    }
+    return true;
+}
+
+static void
+snap_to_target(SmoothCursor *sc) {
+    memcpy(sc->rect, sc->target, sizeof(sc->rect));
+    sc->alpha = sc->target_alpha;
+}
+
+// RenderRect::interpolate() from alacritty-smooth-cursor
+static void
+animate(SmoothCursor *sc, float dt) {
+    const float factor = MAX(0.01f, OPT(cursor_smooth_motion_factor));
+    const float spring = MAX(0.01f, OPT(cursor_smooth_motion_spring));
+    const float leading = step_fraction(factor, dt), trailing = step_fraction(factor * spring, dt);
+    const float *t = sc->target;
+    float *r = sc->rect;
+    const float dx = t[LEFT] - r[LEFT], dy = t[TOP] - r[TOP];
+
+    float x1 = lerp(r[LEFT], t[LEFT], dx < 0 ? leading : trailing);
+    float y1 = lerp(r[TOP], t[TOP], dy < 0 ? leading : trailing);
+    float x2 = lerp(r[RIGHT], t[RIGHT], dx > 0 ? leading : trailing);
+    float y2 = lerp(r[BOTTOM], t[BOTTOM], dy > 0 ? leading : trailing);
+
+    // Limit the stretch by holding back the leading edges
+    const float width = MIN(x2 - x1, (t[RIGHT] - t[LEFT]) * OPT(cursor_smooth_motion_max_stretch_x));
+    const float height = MIN(y2 - y1, (t[BOTTOM] - t[TOP]) * OPT(cursor_smooth_motion_max_stretch_y));
+    if (dx < 0) x1 = x2 - width;
+    else x2 = x1 + width;
+    if (dy < 0) y1 = y2 - height;
+    else y2 = y1 + height;
+
+    r[LEFT] = x1;
+    r[TOP] = y1;
+    r[RIGHT] = x2;
+    r[BOTTOM] = y2;
+    sc->alpha = lerp(sc->alpha, sc->target_alpha, step_fraction(factor / 3.f, dt));
+}
+
+bool
+update_smooth_cursor(SmoothCursor *sc, Window *w, monotonic_t now, OSWindow *os_window) {
+    const bool was_active = sc->active;
+    float target[4], target_alpha;
+    bool hollow, pending = false;
+    compute_target(w, os_window, target, &target_alpha, &hollow);
+
+    // Antijitter: the target follows the cursor at most once every
+    // cursor_smooth_motion_antijitter, so that cursors jumping around during
+    // UI updates are not chased
+    if (!sc->has_target || !rects_equal(target, sc->target) || target_alpha != sc->target_alpha || hollow != sc->hollow) {
+        const monotonic_t wait = sc->target_set_at + OPT(cursor_smooth_motion_antijitter) - now;
+        if (!sc->has_target || wait <= 0) {
+            memcpy(sc->target, target, sizeof(sc->target));
+            sc->target_alpha = target_alpha;
+            sc->hollow = hollow;
+            sc->target_set_at = now;
+            sc->has_target = true;
+        } else pending = true; // keeps the animation running until the target can move
+    }
+
+    if (!sc->has_rect || os_window->live_resize.in_progress || (sc->target_alpha == 0.f && sc->alpha < ALPHA_TOLERANCE)) {
+        // Nothing to animate from, or nothing visible to animate
+        snap_to_target(sc);
+        sc->has_rect = true;
+    } else if (!was_active) {
+        // The first frame after the cursor was at rest only starts the
+        // animation, the time since the previous step is meaningless
+    } else {
+        animate(sc, (float)monotonic_t_to_s_double(now - sc->updated_at));
+    }
+    sc->updated_at = now;
+
+    const bool settled = rects_close(sc->rect, sc->target) && fabsf(sc->alpha - sc->target_alpha) < ALPHA_TOLERANCE;
+    if (settled) snap_to_target(sc);
+    sc->active = pending || !settled;
+    WD.screen->cursor_render_info.smooth_motion_active = sc->active;
+    // Render while animating and once more to bring back the real cursor
+    return sc->active || was_active;
+}
+
+#undef WD
