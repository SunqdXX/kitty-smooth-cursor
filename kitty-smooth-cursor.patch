+// Smooth cursor {{{
+static void
+srgb_vec3(GLint location, color_type color) {
+    glUniform3f(location, ((color >> 16) & 0xFF) / 255.f, ((color >> 8) & 0xFF) / 255.f, (color & 0xFF) / 255.f);
+}
+
+// Must be called after the frame has been rendered to the layers texture and
+// blitted to the output, the cursor is drawn over the output using the layers
+// texture for the colors below it
+static void
+draw_smooth_cursor(OSWindow *os_window, const SmoothCursor *sc, Window *active_window, float sx, float sy) {
+    if (!active_window || !active_window->render_data.screen) return;
+    Screen *screen = active_window->render_data.screen;
+    // follow blinking so that handing over to the real cursor is seamless
+    const float alpha = sc->alpha * MAX(0.f, MIN(screen->cursor_render_info.cursor_opacity, 1.f));
+    if (alpha <= 0.f) return;
+    const float vw = (float)os_window->viewport_width, vh = (float)os_window->viewport_height;
+    // move with the text during a partial line pixel scroll, like the real cursor
+    const float dy = pixel_scroll_enabled(screen) ? (float)screen->pixel_scroll_offset_y : 0.f;
+    const float left = -1.f + 2.f * sc->rect[0] / vw, top = 1.f - 2.f * (sc->rect[1] + dy) / vh;
+    const float right = -1.f + 2.f * sc->rect[2] / vw, bottom = 1.f - 2.f * (sc->rect[3] + dy) / vh;
+    ColorProfile *cp = screen->paused_rendering.expires_at ? &screen->paused_rendering.color_profile : screen->color_profile;
+#define U(name) program_uniform_location(SMOOTH_CURSOR_PROGRAM, name)
+    bind_program(SMOOTH_CURSOR_PROGRAM);
+    glActiveTexture(GL_TEXTURE0 + GRAPHICS_UNIT);
+    glBindTexture(GL_TEXTURE_2D, global_state.layers_render_texture.texture_id);
+    // texture co-ordinates are bottom up and scaled as for the blit in stop_os_window_rendering()
+    glUniform4f(U("src_rect"), (left + 1.f) * 0.5f * sx, (top + 1.f) * 0.5f * sy, (right + 1.f) * 0.5f * sx, (bottom + 1.f) * 0.5f * sy);
+    glUniform4f(U("dest_rect"), left, top, right, bottom);
+    glUniform2f(U("size_px"), sc->rect[2] - sc->rect[0], sc->rect[3] - sc->rect[1]);
+    srgb_vec3(U("cursor_color"), screen->last_rendered.cursor_bg);
+    srgb_vec3(U("bg_color"), colorprofile_to_color(cp, cp->overridden.default_bg, cp->configured.default_bg).rgb);
+    if (sc->hollow) {
+        // same thickness as add_hollow_cursor() in decorations.c
+        glUniform2f(
+            U("hollow_thickness"),
+            MAX(1.f, roundf((float)os_window->fonts_data->logical_dpi_x / 72.f)),
+            MAX(1.f, roundf((float)os_window->fonts_data->logical_dpi_y / 72.f)));
+    } else glUniform2f(U("hollow_thickness"), 0.f, 0.f);
+    glUniform1f(U("alpha"), alpha);
+#undef U
+    draw_quad(true, 0);
+    unbind_program();
+}
